// ============================================================
// Pattern Tiler - v1.1
// Para usar con el plugin "obs-shaderfilter" de Exeldro
// https://github.com/exeldro/obs-shaderfilter
//
// Inspirado en "OBS Shader - StreamUP Pattern Tiler" por Andilippi
// https://andilippi.co.uk
//
// Proyecto personal asistido por IA para LaViduka.
//
// Instalacion: Anadir como Effect Filter sobre un Colour Source,
// activar "Load shader text from file" o pegar este texto,
// y pulsar "Reload effect" tras cada cambio.
// ============================================================

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter    = Linear;
    AddressU  = Clamp;
    AddressV  = Clamp;
};

sampler_state imageSampler {
    Filter    = Linear;
    AddressU  = Clamp;
    AddressV  = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

// ============================================================
// 1. REJILLA
// ============================================================

uniform int grid_pattern
<
    string label = "Patron de Rejilla";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "Cuadricula";
    int option_1_value = 1;  string option_1_label = "Brick";
    int option_2_value = 2;  string option_2_label = "Hexagonal";
> = 0;

uniform float density
<
    string label = "Densidad del grid";
    string widget_type = "slider";
    float minimum = 2.0;
    float maximum = 200.0;
    float step = 1.0;
> = 20.0;

uniform int square_cells
<
    string label = "Celdas Cuadradas";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "No";
    int option_1_value = 1;  string option_1_label = "Si";
> = 0;

uniform float gap
<
    string label = "Espaciado interior de celda";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.95;
    float step = 0.01;
> = 0.0;

// ============================================================
// 2. FORMA PRINCIPAL
// ============================================================

uniform int shape_type
<
    string label = "Forma";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "Dot";
    int option_1_value = 1;  string option_1_label = "Ring";
    int option_2_value = 2;  string option_2_label = "Square";
    int option_3_value = 3;  string option_3_label = "Diamond";
    int option_4_value = 4;  string option_4_label = "Plus";
    int option_5_value = 5;  string option_5_label = "Polygon";
    int option_6_value = 6;  string option_6_label = "Star";
    int option_7_value = 7;  string option_7_label = "Image / OBS Source";
    int option_8_value = 8;  string option_8_label = "Character (Atlas)";
> = 0;

uniform float shape_size
<
    string label = "Tamano";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float edge_softness
<
    string label = "Suavizado de Borde";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.2;
    float step = 0.001;
> = 0.02;

uniform float rotation_deg
<
    string label = "Rotacion (grados)";
    string widget_type = "slider";
    float minimum = -180.0;
    float maximum = 180.0;
    float step = 1.0;
> = 0.0;

uniform float auto_rotate_speed
<
    string label = "Velocidad de Auto-Rotacion";
    string widget_type = "slider";
    float minimum = -180.0;
    float maximum = 180.0;
    float step = 1.0;
> = 0.0;

uniform int shape_sides
<
    string label = "Lados / Puntas";
    string widget_type = "slider";
    int minimum = 3;
    int maximum = 12;
    int step = 1;
> = 5;

uniform float star_sharpness
<
    string label = "Nitidez de Estrella";
    string widget_type = "slider";
    float minimum = 2.0;
    float maximum = 12.0;
    float step = 0.1;
> = 3.0;

// ============================================================
// 3. MEZCLA DE FORMAS
// ============================================================

uniform int shape_type_b
<
    string label = "Forma B";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "Dot";
    int option_1_value = 1;  string option_1_label = "Ring";
    int option_2_value = 2;  string option_2_label = "Square";
    int option_3_value = 3;  string option_3_label = "Diamond";
    int option_4_value = 4;  string option_4_label = "Plus";
    int option_5_value = 5;  string option_5_label = "Polygon";
    int option_6_value = 6;  string option_6_label = "Star";
    int option_7_value = 7;  string option_7_label = "Image / OBS Source";
    int option_8_value = 8;  string option_8_label = "Character (Atlas)";
> = 6;

uniform float shape_mix_chance
<
    string label = "Probabilidad de Mezcla";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

// ============================================================
// 4. IMAGEN / FUENTE OBS
// ============================================================

uniform int use_source_instead_of_image
<
    string label = "Modo de textura";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "Imagen";
    int option_1_value = 1;  string option_1_label = "Fuente OBS";
> = 1;

uniform texture2d source_tex
<
    string label = "Fuente OBS / Escena";
    string widget_type = "source";
>;

uniform texture2d image_tex
<
    string label = "Imagen / Textura";
    string widget_type = "file";
>;

uniform float image_aspect_override
<
    string label = "Aspecto de Imagen/Source (0=auto)";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.01;
> = 0.0;

// ============================================================
// 5. ATLAS DE CARACTERES
// ============================================================

uniform texture2d font_atlas
<
    string label = "Atlas de Fuente (cuadricula PNG)";
    string widget_type = "file";
>;

uniform int font_cols
<
    string label = "Columnas del Atlas";
    string widget_type = "slider";
    int minimum = 1;
    int maximum = 32;
    int step = 1;
> = 16;

uniform int font_rows
<
    string label = "Filas del Atlas";
    string widget_type = "slider";
    int minimum = 1;
    int maximum = 32;
    int step = 1;
> = 16;

uniform int font_index
<
    string label = "Indice de Caracter";
    string widget_type = "slider";
    int minimum = 0;
    int maximum = 1023;
    int step = 1;
> = 0;

uniform float font_aspect_override
<
    string label = "Aspecto del Caracter (0=auto)";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.01;
> = 0.0;

// ============================================================
// 6. COLOR
// ============================================================

uniform float4 base_color
<
    string label = "Color Base";
    string widget_type = "color";
> = {1.0, 1.0, 1.0, 1.0};

uniform float4 secondary_color
<
    string label = "Color Secundario";
    string widget_type = "color";
> = {1.0, 0.0, 0.0, 1.0};

uniform int color_mode
<
    string label = "Modo de Color Secundario";
    string widget_type = "select";
    int option_0_value = 0;  string option_0_label = "Solido";
    int option_1_value = 1;  string option_1_label = "Gradiente Radial";
    int option_2_value = 2;  string option_2_label = "Alternado por Celda";
    int option_3_value = 3;  string option_3_label = "Por Forma (A=base, B=secundario)";
> = 0;

uniform float color_mix
<
    string label = "Mezcla Color Secundario";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

// ============================================================
